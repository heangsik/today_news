---
export async function getStaticPaths() {
  const entries = await Astro.glob('../../content/news/**/*.md');
  return entries.map((entry) => { const value = entry.frontmatter.date; const date = new Date(value).toISOString().slice(0, 10); return { params: { date }, props: { entry } }; });
}
const { entry } = Astro.props;
---
<html lang="ko"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{entry.frontmatter.title}</title></head><body><main><p><a href={import.meta.env.BASE_URL + 'news/'}>← 지난 뉴스</a></p><entry.Content /></main></body></html>


