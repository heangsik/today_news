---
const newsEntries = await Astro.glob('../content/news/**/*.md');
const latest = newsEntries.sort((a, b) => String(b.frontmatter.date).localeCompare(String(a.frontmatter.date)))[0];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{latest?.frontmatter.title ?? 'Morning News'}</title>
    <style>
      :root { color: #1f1b16; background: #ede6d8; font-family: 'Malgun Gothic', '맑은 고딕', Arial, sans-serif; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      .paper { max-width: 1180px; margin: 0 auto; padding: 28px 42px 72px; background: #f8f3e8; min-height: 100vh; box-shadow: 0 0 24px #2b241514; }
      .masthead { text-align: center; border-top: 4px double #1f1b16; border-bottom: 4px double #1f1b16; padding: 18px 0 12px; }
      .kicker { margin: 0 0 8px; font: 700 0.72rem/1 Arial, sans-serif; letter-spacing: 0.24em; text-transform: uppercase; }
      h1 { margin: 0; font-size: clamp(2.7rem, 7vw, 5.8rem); line-height: 0.9; letter-spacing: -0.06em; }
      .edition { display: flex; justify-content: space-between; gap: 16px; margin-top: 14px; font: 700 0.72rem/1.2 Arial, sans-serif; letter-spacing: 0.08em; text-transform: uppercase; }
      .rule { border: 0; border-top: 1px solid #1f1b16; margin: 24px 0; }
      article :global(h1) { font-size: clamp(1.8rem, 4vw, 3.2rem); line-height: 1; border-bottom: 2px solid #1f1b16; padding-bottom: 10px; margin: 30px 0 18px; }
      article :global(h1:first-child) { margin-top: 0; }
      article :global(h1:not(:first-child)) { column-span: all; }
      article :global(h1 + ol), article :global(h1 + ul) { column-span: all; columns: 2; column-gap: 32px; padding-left: 24px; }
      article :global(h3), article :global(h3 ~ p) { break-inside: avoid; }
      article :global(h3) { font-size: 1.18rem; line-height: 1.15; margin: 20px 0 8px; }
      article :global(p), article :global(li) { font-size: 0.98rem; line-height: 1.55; }
      article :global(a) { color: #6e1d16; text-decoration-thickness: 1px; text-underline-offset: 3px; }
      @media (max-width: 700px) { .paper { padding: 18px 18px 48px; } .edition { font-size: 0.62rem; } article :global(h1 + ol), article :global(h1 + ul) { columns: 1; } article :global(p), article :global(li) { font-size: 0.94rem; } }
    </style>
  </head>
  <body>
    <main class="paper">
      <header class="masthead">
        <p class="kicker">Morning Edition · Korea</p>
        <h1>Morning News</h1>
        <div class="edition"><span>{latest?.frontmatter.title ?? '오늘의 아침 뉴스'}</span><span>{latest?.frontmatter.date ?? '발행일 미정'}</span></div>
      </header>
      <hr class="rule" />
      <article>{latest ? <latest.Content /> : <p>아직 생성된 뉴스가 없습니다.</p>}</article>
    </main>
  </body>
</html>
